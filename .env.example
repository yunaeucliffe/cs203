LTA_DATAMALL_API_KEY=YOUR_API_KEY_HERE

ONEMAP_EMAIL=your_email@example.com
ONEMAP_PASSWORD=your_password

# Database. Leave DB_URL commented out for local development (DB_HOST/DB_NAME/
# DB_SSLMODE compose the URL below). For an external database, either
# uncomment DB_URL and set it to the provider's full JDBC connection string,
# or set DB_HOST, DB_NAME, DB_USERNAME and DB_SSLMODE=require (or stricter)
# individually. A blank DB_URL is treated the same as an unset one.
DB_HOST=[::1]
DB_NAME=silverroute
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password
DB_SSLMODE=disable
# DB_URL=jdbc:postgresql://host:5432/dbname?sslmode=require

SESSION_COOKIE_SECURE=false
OPENAI_API_KEY=
OPENAI_MODEL=

# Shared secret the deployed cron job must send as "Authorization: Bearer
# <value>" to call /api/internal/trip-shares/cleanup. Leave unset locally;
# that endpoint rejects every request until this is set.
CRON_SECRET=
