# Base URL of the SilverRoute backend. Leave unset for local development, where the
# backend runs on its default port.
VITE_API_URL=https://silverroute-backend.example.com

# Switches the demo journey simulation on for every session of this deployment. Leave unset
# for anything user-facing: a presenter can switch it on per device with ?demo=1 instead.
VITE_DEMO_MODE=false
