# Where the frontend calls the SilverRoute API. Leave unset for local development, where the
# backend runs on its own port. Use "/" when the API is reached through a same-origin proxy
# (the recommended Vercel setup), or the backend's base URL when it has its own origin.
VITE_API_URL=/

# Switches the demo journey simulation on for every session of this deployment. Leave unset
# for anything user-facing: a presenter can switch it on per device with ?demo=1 instead.
VITE_DEMO_MODE=false
